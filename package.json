{
  "name": "dazza",
  "version": "0.1.1",
  "description": "Stop operating your coding agent. Start managing it.",
  "keywords": [
    "claude-code",
    "codex",
    "ai",
    "agent",
    "cli",
    "project-management",
    "coding-agent",
    "mcp"
  ],
  "homepage": "https://dazza.nrthstar.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harrison-bbb/dazza.git"
  },
  "bugs": {
    "url": "https://github.com/harrison-bbb/dazza/issues"
  },
  "license": "MIT",
  "author": "Harrison Smith",
  "type": "module",
  "bin": {
    "dazza": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup && vite build --config web/vite.config.ts",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "dev:web": "vite --config web/vite.config.ts",
    "prepublishOnly": "pnpm check && pnpm build"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "commander": "^15.0.0",
    "hono": "^4.13.9",
    "playwright-core": "^1.63.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@10.33.0",
  "publishConfig": {
    "access": "public"
  }
}
